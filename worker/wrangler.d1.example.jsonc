{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Copy to a private environment-specific config and replace resource IDs.
  // This example is not used by CI deployment or the managed production config.
  "name": "snare-callback-example",
  "main": "index.js",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "SNARE_DB",
    "database_name": "snare-state-example",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "STORAGE_BACKEND": "d1",
    "SNARE_ENVIRONMENT": "example",
    "ENROLLMENT_MODE": "closed",
    "RATE_LIMITS_REQUIRED": "true",
    "GLOBAL_WEBHOOK_DEVICE_IDS": ""
  },
  // Replace namespace IDs with unused account IDs, distinct for each environment.
  "ratelimits": [
    { "name": "ENROLLMENT_RATE_LIMITER", "namespace_id": "1101", "simple": { "limit": 3, "period": 60 } },
    { "name": "API_SOURCE_RATE_LIMITER", "namespace_id": "1102", "simple": { "limit": 120, "period": 60 } },
    { "name": "CALLBACK_SOURCE_RATE_LIMITER", "namespace_id": "1103", "simple": { "limit": 600, "period": 60 } },
    { "name": "API_DEVICE_RATE_LIMITER", "namespace_id": "1104", "simple": { "limit": 120, "period": 60 } },
    { "name": "NOTIFICATION_RATE_LIMITER", "namespace_id": "1105", "simple": { "limit": 1, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
  // Optional Queues mode: add a WEBHOOK_DELIVERY_QUEUE producer and consumer
  // for the SAME environment-specific queue. See docs/webhook-delivery.md.
  // Keep webhook and enrollment secrets in remote Worker secrets, not vars.
}
