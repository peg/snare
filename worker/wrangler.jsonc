{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "snare-callback",
  "main": "index.js",
  "compatibility_date": "2026-07-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "snare.sh/c/*",
      "zone_name": "snare.sh"
    },
    {
      "pattern": "snare.sh/api/*",
      "zone_name": "snare.sh"
    },
    {
      "pattern": "snare.sh/health",
      "zone_name": "snare.sh"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SNARE_KV",
      "id": "a8acd39e2d1b4545b8d3afc0e17d3432"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "env": {
    "staging": {
      "name": "snare-callback-staging",
      "routes": [
        {
          "pattern": "staging.snare.sh",
          "custom_domain": true
        }
      ],
      "kv_namespaces": [],
      "d1_databases": [
        {
          "binding": "SNARE_DB",
          "database_name": "snare-state-staging",
          "database_id": "5e787904-23b9-4c46-9f19-fb94a9210dd8",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "ENROLLMENT_RATE_LIMITER", "namespace_id": "2101", "simple": { "limit": 3, "period": 60 } },
        { "name": "API_SOURCE_RATE_LIMITER", "namespace_id": "2102", "simple": { "limit": 120, "period": 60 } },
        { "name": "CALLBACK_SOURCE_RATE_LIMITER", "namespace_id": "2103", "simple": { "limit": 600, "period": 60 } },
        { "name": "API_DEVICE_RATE_LIMITER", "namespace_id": "2104", "simple": { "limit": 120, "period": 60 } },
        { "name": "NOTIFICATION_RATE_LIMITER", "namespace_id": "2105", "simple": { "limit": 1, "period": 60 } }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "SNARE_ENVIRONMENT": "staging",
        "STORAGE_BACKEND": "d1",
        "RATE_LIMITS_REQUIRED": "true"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
  // WEBHOOK_URLS remains a remote Worker secret and is never committed. If
  // configured for staging, it must point to a dedicated non-production sink.
}
